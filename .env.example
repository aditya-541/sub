# Bittensor chain settings. Use `local` during isolated localnet development.
BT_NETWORK=local
FACTORY_NETUID=2
BT_WALLET=factory-validator
BT_WALLET_HOTKEY=default

# Client calls to validator APIs use this bearer token. Replace before use.
FACTORY_API_TOKEN=replace-with-a-long-random-secret

# Set FACTORY_LOCAL_MODE=1 only for local multi-process tests. This disables
# hotkey request authentication and must never be used on public interfaces.
FACTORY_LOCAL_MODE=0
FACTORY_LOCAL_PEERS=

# Each miner operator chooses their own model/tool wrapper.
FACTORY_GENERATOR_COMMAND=

FACTORY_STATE_DB=./data/factory.sqlite3
FACTORY_ARTIFACT_ROOT=./artifacts
FACTORY_BUILD_QUEUE_LIMIT=16
FACTORY_BIND_HOST=0.0.0.0
FACTORY_PORT=8000
FACTORY_HOST_PORT=8000
FACTORY_HOST_BIND=127.0.0.1

# Optional browser client origins, comma-separated, exact origins only.
FACTORY_CORS_ORIGINS=http://localhost:3000
FACTORY_DOMAIN=localhost
